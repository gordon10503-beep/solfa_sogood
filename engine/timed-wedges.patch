+    // Studio patch: index timed hairpin endpoints once for the current system.
+    private SIGraph wedgeGraph;
+    private final Map<Measure, List<TimedWedge>> wedgesByMeasure = new HashMap<>();
+
+    private void indexWedges (SIGraph graph)
+    {
+        if (graph == wedgeGraph) {
+            return;
+        }
+        wedgesByMeasure.clear();
+        wedgeGraph = graph;
+        for (Inter inter : graph.inters(WedgeInter.class)) {
+            WedgeInter wedge = (WedgeInter) inter;
+            List<TimedWedge> pair = new ArrayList<>(2);
+            for (HorizontalSide side : HorizontalSide.values()) {
+                AbstractChordInter chord = wedge.getChord(side);
+                if (chord == null) {
+                    continue;
+                }
+                if (chord.getTimeOffset() == null || chord.getNotes().isEmpty() || chord.getMeasure() == null) {
+                    // Abandon this uncertain hairpin, preserving the notes in its measure.
+                    pair.clear();
+                    break;
+                }
+                pair.add(new TimedWedge(wedge, side, (AbstractNoteInter) chord.getNotes().get(0),
+                        chord.getTimeOffset()));
+            }
+            for (TimedWedge event : pair) {
+                Measure owner = wedge.getChord(event.side).getMeasure();
+                wedgesByMeasure.computeIfAbsent(owner, key -> new ArrayList<>()).add(event);
+            }
+        }
+    }
